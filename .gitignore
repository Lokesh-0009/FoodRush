# =============================================================================
# FoodRush - Git Ignore Configuration
# =============================================================================

# --- Compiled Java & Build Outputs ---
*.class
/build/
build/
bin/
target/
src/main/webapp/WEB-INF/classes/

# --- Sensitive Credentials & Environment Files ---
*email.properties
email.properties
src/main/resources/email.properties
src/main/java/email.properties
src/main/webapp/WEB-INF/classes/email.properties
*db.properties
db.properties
src/main/resources/db.properties
src/main/java/db.properties
src/main/webapp/WEB-INF/classes/db.properties
*.env
*.env.*
*.key
*.pem
credentials.json
secrets/

# --- Temporary / Scratch Files ---
sources.txt
*.tmp
*.bak
*.swp
*~
*.log

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Local IDE Caches (Keeps .project & .classpath for standard Eclipse Dynamic Web import) ---
.recommenders/
.metadata/
.vscode/
.idea/
*.iml
*.iws
*.suo
*.user
*.userosv
